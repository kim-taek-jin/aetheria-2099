{
  "name": "aetheria-2099",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-driven interactive fiction — Aetheria 2099 (BYOK Gemini)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "ml:split": "node ml/split-dataset.mjs",
    "electron:dev": "ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "electron:preview": "npm run build && electron .",
    "desktop": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.aetheria.game",
    "productName": "Aetheria 2099",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^4.1.10"
  }
}
